# live-control-plane (Rails API) のベースURL
# 配信用のingest endpoint/stream keyはチャネル作成・選択時にこのAPI経由で取得するため、
# ここでは直接指定しない
# ※ live-control-plane はデフォルトの3000番ポートで起動する想定のため、
#   このfrontendは別ポート（例: 5500番、`npx serve -l 5500 frontend`）で配信してください
API_BASE_URL=http://localhost:3000

# 視聴側の再生URL（.m3u8）
PLAYBACK_URL=https://xxxxxx.ap-northeast-1.playback.live-video.net/api/video/v1/xxxxxx.m3u8
